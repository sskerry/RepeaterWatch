[Unit]
Description=RepeaterWatch
After=network.target SerialMux.service
# Wants= (not Requires=) so that stopping SerialMux does NOT stop RepeaterWatch.
# This is important: the firmware flash feature stops SerialMux intentionally.
Wants=SerialMux.service

[Service]
Type=simple
WorkingDirectory=/opt/RepeaterWatch
ExecStart=/opt/RepeaterWatch/venv/bin/python app.py
Restart=always
RestartSec=10
# Configuration is loaded from .env file in WorkingDirectory (see .env.example)

[Install]
WantedBy=multi-user.target
