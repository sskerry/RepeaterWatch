# Authentication — set password via setup_auth.py or the Settings page
# MESHCORE_PASSWORD_HASH=
MESHCORE_SECRET_KEY=

# Serial (via SerialMux virtual port)
MESHCORE_SERIAL_PORT=/dev/ttyV0
MESHCORE_SERIAL_BAUD=115200
MESHCORE_SERIAL_TIMEOUT=5

# Polling
MESHCORE_POLL_INTERVAL=300

# Database
MESHCORE_DB_PATH=/opt/RepeaterWatch/meshcore.db
MESHCORE_RETENTION_DAYS=30

# Flask
MESHCORE_HOST=0.0.0.0
MESHCORE_PORT=5000
MESHCORE_DEBUG=0

# Firmware flash
MESHCORE_FLASH_SERIAL_PORT=/dev/serial/by-id/usb-YOUR_DEVICE_ID-if00
MESHCORE_FIRMWARE_UPLOAD_DIR=/tmp/meshcore-fw

# Terminal
MESHCORE_TERMINAL_SERIAL_PORT=/dev/ttyV2
MESHCORE_TERMINAL_SERIAL_BAUD=115200

# Hardware label (shown on dashboard — board type is also auto-detected from serial)
# MESHCORE_HARDWARE=

# Login protection (fail2ban-style)
# MESHCORE_LOGIN_MAX_ATTEMPTS=5
# MESHCORE_LOGIN_LOCKOUT_SECS=300

# Trusted reverse proxies (comma-separated IPs, e.g. "127.0.0.1,10.0.0.1")
# MESHCORE_TRUSTED_PROXIES=

# Sensors (all disabled by default — enable in the Sensors tab)
MESHCORE_SENSOR_POLL=0
# MESHCORE_SENSOR_INA3221=0
# MESHCORE_SENSOR_BME280=0
# MESHCORE_SENSOR_LIS2DW12=0
# MESHCORE_SENSOR_AS3935=0
# MESHCORE_SENSOR_BQ24074=0

# Dual-radio mode (cross-band repeater) — OFF by default.
# When 1, RepeaterWatch hosts a second radio (radio B) alongside radio A.
# Each radio needs its own SerialMux + mctomqtt instance, distinct IATA, and
# distinct GPIO pins. See docs/PROVISIONING.md (ops repo) for the install
# walkthrough.
# MESHCORE_DUAL_RADIO_MODE=0

# Radio A label / IATA (shown on the dashboard tab; falls back to MESHCORE_IATA)
# MESHCORE_RADIO_A_LABEL=Radio
# MESHCORE_IATA_A=

# Radio B — only consulted when MESHCORE_DUAL_RADIO_MODE=1
# MESHCORE_RADIO_B_LABEL=Radio B
# MESHCORE_SERIAL_PORT_B=/dev/ttyV0b
# MESHCORE_SERIAL_BAUD_B=115200
# MESHCORE_FLASH_SERIAL_PORT_B=/dev/serial/by-id/usb-YOUR_RADIO_B_ID-if00
# MESHCORE_TERMINAL_SERIAL_PORT_B=/dev/ttyV2b
# MESHCORE_TERMINAL_SERIAL_BAUD_B=115200
# MESHCORE_RADIO_RESET_GPIO_B=    # MUST be distinct from MESHCORE_RADIO_RESET_GPIO
# MESHCORE_USB_RELAY_GPIO_B=      # MUST be distinct from MESHCORE_USB_RELAY_GPIO
# MESHCORE_IATA_B=
